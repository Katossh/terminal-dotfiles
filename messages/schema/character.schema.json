{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character.schema.json",
  "title": "Terminal failure-message character",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "persona",
    "min_rarity",
    "max_rarity",
    "adult_content_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "persona": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "min_rarity": {
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary",
        "mythic"
      ]
    },
    "max_rarity": {
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary",
        "mythic"
      ]
    },
    "adult_content_eligible": {
      "type": "boolean"
    }
  }
}
