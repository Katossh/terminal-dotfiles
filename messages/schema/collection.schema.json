{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collection.schema.json",
  "title": "Terminal failure-message collection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "messages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "character_id",
          "category",
          "style",
          "rarity",
          "severity",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "character_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "category": {
            "enum": [
              "any",
              "not_found",
              "permission",
              "missing_path",
              "git",
              "nix",
              "network",
              "generic"
            ]
          },
          "style": {
            "enum": [
              "normal",
              "anime",
              "ecchi",
              "sarcastic",
              "dramatic",
              "rainbow",
              "legendary",
              "mythic"
            ]
          },
          "rarity": {
            "enum": [
              "common",
              "uncommon",
              "rare",
              "epic",
              "legendary",
              "mythic"
            ]
          },
          "severity": {
            "enum": [
              "base",
              "repeat",
              "severe"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          }
        }
      }
    }
  }
}
