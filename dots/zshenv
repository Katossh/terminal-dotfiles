# Shared environment variables loaded by every Zsh process.
# Keep credentials and machine-specific secrets out of this tracked file.

# XDG base directories
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export STARSHIP_CONFIG="${STARSHIP_CONFIG:-$XDG_CONFIG_HOME/starship.toml}"

# Some systems (notably macOS and WSL) do not provide XDG_RUNTIME_DIR.
# Never fall back to shared /tmp directly: create a private per-user directory.
if [[ -z "${XDG_RUNTIME_DIR:-}" || ! -d "$XDG_RUNTIME_DIR" || ! -w "$XDG_RUNTIME_DIR" ]]; then
    XDG_RUNTIME_DIR="/run/user/$UID"
    if [[ ! -d "$XDG_RUNTIME_DIR" || ! -w "$XDG_RUNTIME_DIR" ]]; then
        _xdg_runtime_root="${TMPDIR:-/tmp}"
        XDG_RUNTIME_DIR="${_xdg_runtime_root%/}/dotfiles-runtime-$UID"
        if [[ ! -e "$XDG_RUNTIME_DIR" && ! -L "$XDG_RUNTIME_DIR" ]]; then
            (umask 077 && mkdir "$XDG_RUNTIME_DIR") 2>/dev/null || true
        fi
        if [[ -d "$XDG_RUNTIME_DIR" && ! -L "$XDG_RUNTIME_DIR" && -O "$XDG_RUNTIME_DIR" && -w "$XDG_RUNTIME_DIR" ]]; then
            chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
        else
            XDG_RUNTIME_DIR="$XDG_CACHE_HOME/runtime"
            mkdir -p "$XDG_RUNTIME_DIR"
            chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
        fi
        unset _xdg_runtime_root
    fi
fi
export XDG_RUNTIME_DIR

# Keep Zsh configuration under XDG_CONFIG_HOME.
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# Find the checkout through the installed manager first. This survives file-level
# links and lets a personal .zshrc override replace the repository default.
if [[ -z "${DOTFILES_DIR:-}" && -x "$HOME/.local/bin/dots" ]]; then
    _dots_entry="$HOME/.local/bin/dots"
    _dots_hops=0
    while [[ -L "$_dots_entry" && "$_dots_hops" -lt 20 ]]; do
        _dots_target="$(readlink "$_dots_entry" 2>/dev/null || true)"
        [[ -n "$_dots_target" ]] || break
        case "$_dots_target" in
            /*) _dots_entry="$_dots_target" ;;
            *) _dots_entry="$(dirname "$_dots_entry")/$_dots_target" ;;
        esac
        _dots_hops=$((_dots_hops + 1))
    done
    _dots_root="$(cd -P "$(dirname "$_dots_entry")/.." 2>/dev/null && pwd -P)"
    [[ -f "$_dots_root/manifest/configs.tsv" ]] && DOTFILES_DIR="$_dots_root"
fi

# Fallback for legacy installs where the whole Zsh config directory was linked.
if [[ -z "${DOTFILES_DIR:-}" && -L "$ZDOTDIR" ]]; then
    _zsh_config_real="$ZDOTDIR"
    _zsh_dir_hops=0
    while [[ -L "$_zsh_config_real" && "$_zsh_dir_hops" -lt 20 ]]; do
        _zsh_dir_target="$(readlink "$_zsh_config_real" 2>/dev/null || true)"
        [[ -n "$_zsh_dir_target" ]] || break
        case "$_zsh_dir_target" in
            /*) _zsh_config_real="$_zsh_dir_target" ;;
            *) _zsh_config_real="$(dirname "$_zsh_config_real")/$_zsh_dir_target" ;;
        esac
        _zsh_dir_hops=$((_zsh_dir_hops + 1))
    done
    _zsh_config_real="$(cd -P "$_zsh_config_real" 2>/dev/null && pwd -P)"
    case "$_zsh_config_real" in
        */config/terminal/zsh) DOTFILES_DIR="${_zsh_config_real%/config/terminal/zsh}" ;;
    esac
fi
if [[ -z "${DOTFILES_DIR:-}" ]]; then
    _zsh_anchor="$ZDOTDIR/.zshrc"
    _zsh_hops=0
    while [[ -L "$_zsh_anchor" && "$_zsh_hops" -lt 20 ]]; do
        _zsh_target="$(readlink "$_zsh_anchor" 2>/dev/null || true)"
        [[ -n "$_zsh_target" ]] || break
        case "$_zsh_target" in
            /*) _zsh_anchor="$_zsh_target" ;;
            *) _zsh_anchor="$(dirname "$_zsh_anchor")/$_zsh_target" ;;
        esac
        _zsh_hops=$((_zsh_hops + 1))
    done
    _zsh_config_dir="$(cd -P "$(dirname "$_zsh_anchor")" 2>/dev/null && pwd -P)"
    case "$_zsh_config_dir" in
        */config/terminal/zsh) DOTFILES_DIR="${_zsh_config_dir%/config/terminal/zsh}" ;;
    esac
fi
export DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
unset _dots_entry _dots_hops _dots_target _dots_root _zsh_anchor _zsh_hops _zsh_target _zsh_config_dir _zsh_config_real _zsh_dir_hops _zsh_dir_target

# Application defaults; override these in a local shell profile if needed.
export GPG_TTY="${TTY:-$(tty 2>/dev/null || true)}"
if [[ "$OSTYPE" == darwin* ]]; then
    export BROWSER="${BROWSER:-open}"
else
    export BROWSER="${BROWSER:-xdg-open}"
fi
export TERMINAL="${TERMINAL:-kitty}"
export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-$EDITOR}"
export PAGER="${PAGER:-less}"

export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=8"
export NODE_REPL_HISTORY="$XDG_DATA_HOME/node_repl_history"
export ZSHZ_DATA="$XDG_DATA_HOME/z/z"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"
export LESSHISTFILE="-"

# Optional personal paths. Configure these locally instead of committing them.
# export ZK_NOTEBOOK_DIR="$HOME/Dropbox/notes"
# export ANDROID_SDK_ROOT="$HOME/Android/Sdk"
# export GRADLE_USER_HOME="$XDG_DATA_HOME/gradle"
# export JUPYTER_CONFIG_DIR="$XDG_CONFIG_HOME/jupyter"
# export MPLCONFIGDIR="$XDG_CONFIG_HOME/matplotlib"

# Use ripgrep to populate FZF's default file list when it is installed.
if command -v rg >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='rg --files --hidden --no-ignore-vcs --ignore-file "$XDG_CONFIG_HOME/ripgrep/ignore"'
fi

# Shared terminal palette and application adapters.
_dots_palette="$DOTFILES_DIR/themes/palettes/catppuccin-mocha.env"
_dots_local_palette="$XDG_CONFIG_HOME/dots/theme.local.env"
if [[ -r "$_dots_palette" ]]; then
    for _dots_palette_file in "$_dots_palette" "$_dots_local_palette"; do
        [[ -r "$_dots_palette_file" ]] || continue
        while IFS='=' read -r _dots_key _dots_value; do
            [[ "$_dots_key" == DOTS_THEME_* ]] || continue
            [[ "$_dots_value" =~ ^#[0-9A-Fa-f]{6}$ ]] || continue
            export "$_dots_key=$_dots_value"
        done < "$_dots_palette_file"
    done
    [[ -r "$DOTFILES_DIR/themes/adapters/fzf.zsh" ]] && source "$DOTFILES_DIR/themes/adapters/fzf.zsh"
fi
unset _dots_palette _dots_local_palette _dots_palette_file _dots_key _dots_value

# Never put GITHUB_TOKEN, API keys, passwords, or private keys in this file.
# Authenticate with gh auth login or use an external/local secret manager.
