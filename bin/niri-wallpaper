#!/usr/bin/env bash
set -Eeuo pipefail

for dependency in rofi swww magick find sort sha256sum stat readlink notify-send; do
    command -v "$dependency" >/dev/null 2>&1 || {
        printf 'niri-wallpaper: %s is required.\n' "$dependency" >&2
        exit 127
    }
done

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
config_dir="$config_home/rofi"
cache_dir="$cache_home/niri-wallpaper/thumbnails"
menu_file="$(mktemp "${TMPDIR:-/tmp}/niri-wallpaper.XXXXXX")"
trap 'rm -f "$menu_file"' EXIT

# Personal images take precedence in the menu; NixOS-provided licensed
# wallpapers are included automatically by nix/niri.nix.
mkdir -p "$HOME/Pictures/Wallpapers" "$cache_dir"

wallpaper_roots=()
for directory in \
    "$HOME/Pictures/Wallpapers" \
    "$HOME/Pictures/wallpapers" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/dots/wallpapers" \
    /etc/niri/wallpapers; do
    [[ -d "$directory" ]] && wallpaper_roots+=("$directory")
done

images=()
labels=()
declare -A seen_images=()

for directory in "${wallpaper_roots[@]}"; do
    while IFS= read -r -d '' file; do
        resolved="$(readlink -f -- "$file" 2>/dev/null || printf '%s' "$file")"
        [[ -n "${seen_images[$resolved]:-}" ]] && continue
        seen_images["$resolved"]=1

        case "$directory" in
            /etc/niri/wallpapers) origin="NixOS" ;;
            *) origin="Personal" ;;
        esac
        relative="${file#"$directory"/}"
        label="$origin / $relative"

        # Use file identity and metadata to avoid regenerating thumbnails on
        # every invocation while still refreshing changed images.
        metadata="$(stat -c '%s:%Y' -- "$file")"
        cache_key="$(printf '%s\0%s' "$resolved" "$metadata" | sha256sum | cut -c1-24)"
        thumbnail="$cache_dir/$cache_key.png"

        if [[ ! -s "$thumbnail" ]]; then
            if ! magick "${file}[0]" -auto-orient -thumbnail '220x340^' \
                -gravity center -extent 220x340 "$thumbnail"; then
                printf 'niri-wallpaper: failed to thumbnail %s\n' "$file" >&2
                continue
            fi
        fi

        images+=("$file")
        labels+=("$label")
        printf '%s\0icon\x1f%s\n' "$label" "$thumbnail" >> "$menu_file"
    done < <(
        find -L "$directory" -type f \
            \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.avif' \) \
            -print0 | sort -z
    )
done

if (("${#images[@]}" == 0)); then
    notify-send -a niri-wallpaper "No wallpapers found" \
        "Add images to ~/Pictures/Wallpapers. NixOS wallpapers appear after nixos-rebuild switch."
    exit 0
fi

selected="$(
    rofi -dmenu -i -show-icons -p 'Wallpaper' \
        -config "$config_dir/config.rasi" \
        -theme "$config_dir/themes/bgselector.rasi" \
        < "$menu_file"
)"
[[ -n "$selected" ]] || exit 0

selected_image=""
for index in "${!labels[@]}"; do
    if [[ "${labels[$index]}" == "$selected" ]]; then
        selected_image="${images[$index]}"
        break
    fi
done

[[ -n "$selected_image" ]] || {
    printf 'niri-wallpaper: selected image could not be resolved.\n' >&2
    exit 1
}

# Niri starts swww-daemon at session startup. Wait briefly for its socket
# rather than failing when the user opens the picker immediately after login.
ready=0
for _ in {1..30}; do
    if swww query >/dev/null 2>&1; then
        ready=1
        break
    fi
    sleep 0.2
done

if ((ready == 0)); then
    notify-send -a niri-wallpaper "Wallpaper service unavailable" \
        "swww-daemon is not responding. Check the Niri session startup."
    exit 1
fi

swww img "$selected_image" --transition-type grow --transition-duration 1 --transition-fps 60
