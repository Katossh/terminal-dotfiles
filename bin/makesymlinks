#!/usr/bin/env bash
set -Eeuo pipefail

# Backwards-compatible entry point; the main installer owns all linking logic.
# Resolve symlinks without GNU-only readlink -f so this also works on BSD/macOS.
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
    link_dir="$(cd -P "$(dirname "$script_path")" >/dev/null 2>&1 && pwd -P)"
    link_target="$(readlink "$script_path")" || break
    case "$link_target" in
        /*) script_path="$link_target" ;;
        *) script_path="$link_dir/$link_target" ;;
    esac
done
repo_dir="$(cd -P "$(dirname "$script_path")/.." >/dev/null 2>&1 && pwd -P)"
exec "$repo_dir/install.sh" "$@"
