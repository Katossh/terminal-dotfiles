#!/usr/bin/env zsh

# Source this file from Zsh to define and run the project picker.
# It lists directories directly under $HOME plus common development roots.
project() {
    emulate -L zsh
    setopt local_options null_glob

    local -a dirs
    local root selected
    typeset -U dirs

    dirs=("$HOME"/*(/N))

    for root in \
        "$HOME/src" \
        "$HOME/projects" \
        "$HOME/Code" \
        "$HOME/workspaces" \
        "$HOME/docker" \
        "$HOME/notes" \
        "$HOME/Notes"; do
        [[ -d "$root" ]] && dirs+=("$root"/*(/N))
    done

    if (( ${#dirs[@]} == 0 )); then
        print -u2 "project: no directories found"
        return 1
    fi

    selected="$(printf '%s\n' "${dirs[@]}" | fzf --prompt='Project> ' --height=40% --layout=reverse)" || return 130
    [[ -n "$selected" ]] || return 1

    cd -- "$selected"
}

project
