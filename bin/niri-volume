#!/usr/bin/env bash
set -Eeuo pipefail

command -v wpctl >/dev/null 2>&1 || {
    printf 'niri-volume: wpctl (WirePlumber) is required.\n' >&2
    exit 127
}

case "${1:-}" in
    up)
        wpctl set-mute @DEFAULT_SINK@ 0
        wpctl set-volume @DEFAULT_SINK@ 5%+
        ;;
    down)
        wpctl set-mute @DEFAULT_SINK@ 0
        wpctl set-volume @DEFAULT_SINK@ 5%-
        ;;
    mute)
        wpctl set-mute @DEFAULT_SINK@ toggle
        ;;
    *)
        printf 'Usage: niri-volume {up|down|mute}\n' >&2
        exit 2
        ;;
esac

read -r _ volume status < <(wpctl get-volume @DEFAULT_SINK@)
percent="$(awk -v value="$volume" 'BEGIN { printf "%d", value * 100 }')"

if [[ "${status:-}" == "[MUTED]" ]]; then
    notify-send -a muted -h int:value:0 "Audio" "Muted"
else
    notify-send -a volume -h "int:value:$percent" "Audio" "Volume: $percent%"
fi
