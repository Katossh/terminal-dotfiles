#!/usr/bin/env bash
set -Eeuo pipefail

for dependency in rofi systemctl niri; do
    command -v "$dependency" >/dev/null 2>&1 || {
        printf 'niri-powermenu: %s is required.\n' "$dependency" >&2
        exit 127
    }
done

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/rofi"
theme="$config_dir/themes/powermenu.rasi"

choice="$(
    printf '%s\n' \
        '󰐥  Power off' \
        '󰜉  Restart' \
        '󰒲  Suspend' \
        '󰍃  Log out' |
        rofi -dmenu -i -no-custom -p 'Session' \
            -config "$config_dir/config.rasi" \
            -theme "$theme"
)"

case "$choice" in
    '󰐥  Power off') systemctl poweroff ;;
    '󰜉  Restart') systemctl reboot ;;
    '󰒲  Suspend') systemctl suspend ;;
    '󰍃  Log out') niri msg action quit ;;
    *) exit 0 ;;
esac
