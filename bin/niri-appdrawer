#!/usr/bin/env bash
set -Eeuo pipefail

command -v rofi >/dev/null 2>&1 || {
    printf 'niri-appdrawer: rofi is required.\n' >&2
    exit 127
}

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/rofi"
theme="$config_dir/themes/appdrawer.rasi"

[[ -r "$theme" ]] || {
    printf 'niri-appdrawer: missing Rofi theme: %s\n' "$theme" >&2
    exit 1
}

exec rofi -show drun -config "$config_dir/config.rasi" -theme "$theme"
